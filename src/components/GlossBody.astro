---
import type { Gloss } from "../lib/data";
import Parts from "./Parts.astro";
// The body of one term note or guide paragraph: what it is, where the text explains it, the teacher's words.
const { g, teacher } = Astro.props as { g: Gloss; teacher: string };
---
{g.sense && <p class="g-sense">{g.sense}</p>}
{g.defined && g.defined_first && <p class="g-def">Fazang explains it himself at <a href={`#${g.defined_first}`} data-close>{g.defined}</a>.</p>}
{g.teacher.length > 0 && (
  <div class="g-teacher">
    <p class="g-lbl">{g.kind === "guide" ? "The teacher introduces it" : "How the teacher explains it"} <span class="muted">{" — "}{teacher}'s own words, translated</span></p>
    <blockquote>{g.teacher.map((t) => <p>{t}</p>)}</blockquote>
    <p class="g-cite"><Parts parts={g.cite_parts} /></p>
  </div>
)}
{g.flags && <p class={g.flags.includes("⚠") ? "g-flag flag" : "g-flag"}><Parts parts={g.flags_parts} /></p>}
{!g.certified && <p class="uncert">Not yet certified.</p>}
