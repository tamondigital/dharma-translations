---
import Base from "../layouts/Base.astro";
import Parts from "../components/Parts.astro";
import GlossBody from "../components/GlossBody.astro";
import { texts, site, url, type Text } from "../lib/data";

export function getStaticPaths() {
  return texts.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}
const { t } = Astro.props as { t: Text };
const lec = t.lectures[0];
const teacher = t.teacher_en.split(" (")[0];
const notesSeries = lec && `${site.notes}/${lec.channel}/${lec.playlist}/`;
const pageUrl = new URL(url(`${t.slug}/`), Astro.site).href;
const jsonld = {
  "@context": "https://schema.org", "@type": "CreativeWork", name: t.title_en, alternateName: [t.title_zh, t.title_pinyin],
  inLanguage: "en", url: pageUrl, isAccessibleForFree: true, license: "https://creativecommons.org/licenses/by-nc-sa/4.0/",
  translationOfWork: { "@type": "CreativeWork", name: t.title_zh, inLanguage: "zh-Hant", author: { "@type": "Person", name: t.author_en }, identifier: `CBETA ${t.id}` },
  translator: { "@type": "Organization", name: "Claude (Anthropic), AI-generated under human direction" },
  creativeWorkStatus: t.certified ? "Provisional, certified" : "Provisional, under review",
};
const description = `${t.title_en} (${t.title_zh}, ${t.author_en}, CBETA ${t.id}): an English translation to read on its own or line by line beside the Chinese, with ${t.teacher_en}'s explanations of its key terms. AI-generated, provisional.`;
const VIEWS = [["read", "Read"], ["bilingual", "Side by side"], ["how", "How it was made"]];
---
<Base title={`${t.title_en} — English translation`} description={description} jsonld={jsonld} type="article">
  <div id="text" data-view="read">
  <header class="text-head">
    <p class="zh" lang="zh-Hant">{t.title_zh}</p>
    <h1>{t.title_en}</h1>
    <p class="meta"><i>{t.title_pinyin}</i> · {t.author_en} · CBETA {t.id} · {t.n_segs} lines</p>
    <p class="meta">Read with the lectures of {t.teacher_en}{notesSeries && <>: <a href={notesSeries} lang="zh-Hant">study notes and transcripts</a> · <a href={`${site.notes}/sutra/${t.id}/`} lang="zh-Hant">every lecture citing this text</a></>}</p>
    <p class="meta">{t.certified ? <span class="badge">certified {t.certified_at}</span> : <span class="badge warn">{t.n_certified}/{t.n_segs} lines certified</span>} · <a href={url(`files/${t.id}.tsv`)} download>Download (TSV)</a></p>
  </header>

  <div class="viewbar" role="group" aria-label="View">
    {VIEWS.map(([v, l]) => <a class="view-btn" href={`?view=${v}`} data-view-btn={v}>{l}</a>)}
  </div>
  <p class="view-note only-read">The English on its own. Underlined terms open a note: what the term is, where Fazang explains it, and how {teacher} explains it in his lectures.</p>
  <p class="view-note only-bilingual">The Chinese beside the English, line by line, to check one against the other.</p>
  <p class="view-note only-how">Line by line, with the reasons: under each line, <em>Why this reading</em> gives the teacher's reading it follows (linked to the lecture transcript) and any doubt. ⚠ marks an uncertain reading, a variant or a traced quotation; [Tr.] is a note on a term, never on doctrine.</p>

  <div class="notice">
    <p><strong>AI-generated, provisional.</strong> Not an official translation. The term notes give the teacher's own words in translation, cited to the lecture. <a href={url("method/")}>How it is made</a>.</p>
  </div>

  {t.guide.length > 0 && (
    <section class="guide">
      <h2 id="guide">Before you read</h2>
      {t.guide.map((g) => (
        <div class="guide-item" id={`gl-${g.id}`}>
          <h3>{g.term}</h3>
          <GlossBody g={g} teacher={teacher} />
        </div>
      ))}
    </section>
  )}

  <h2 class="not-read">Contents</h2>
  <ol class="toc not-read">
    {t.sections.map((s) => <li><a href={`#${s.start}`}>{s.en}</a> <span lang="zh-Hant" class="muted">{s.zh}</span></li>)}
  </ol>

  {t.sections.map((s) => (
    <section class="sec">
      <h2 class="section-head" id={s.start}>{s.en}<span class="zh" lang="zh-Hant">{s.zh}</span></h2>
      <div class="segs">
      {s.segs.map((g) => (
        <div class="seg" id={g.id}>
          <div class="seg-id"><a href={`#${g.id}`}>{g.id}</a></div>
          <p class="zh" lang="zh-Hant">{g.zh}</p>
          <p class="en"><Parts parts={g.en_parts} /></p>
          {!g.certified && <p class="uncert">Not yet certified.</p>}
          {(g.basis || g.flags) && (
            <details class="why">
              <summary>Why this reading</summary>
              <dl>
                {g.basis && <><dt>Teacher's reading</dt><dd><Parts parts={g.basis_parts} /></dd></>}
                {g.flags && <><dt>Notes</dt><dd class={g.flags.includes("⚠") ? "flag" : undefined}><Parts parts={g.flags_parts} /></dd></>}
              </dl>
            </details>
          )}
        </div>
      ))}
      </div>
    </section>
  ))}

  {t.glossary.length > 0 && (
    <section class="glossary">
      <h2 id="glossary">Glossary</h2>
      <dl>
        {t.glossary.map((g) => (
          <div class="gl-entry" id={`gl-${g.id}`}>
            <dt><span class="gl-term">{g.term}</span> <span lang="zh-Hant">{g.zh}</span>{g.first_seg && <a class="gl-first" href={`#${g.first_seg}`}>{g.first_seg}</a>}</dt>
            <dd><GlossBody g={g} teacher={teacher} /></dd>
          </div>
        ))}
      </dl>
    </section>
  )}
  </div>

  <div id="pop" popover class="pop" role="dialog" aria-label="Term note"></div>

  <script is:inline>
    (() => {
      const box = document.getElementById("text"), VIEWS = ["read", "bilingual", "how"];
      const set = (v, push) => {
        if (!VIEWS.includes(v)) v = "read";
        box.dataset.view = v;
        document.querySelectorAll("[data-view-btn]").forEach((a) => a.setAttribute("aria-current", a.dataset.viewBtn === v ? "true" : "false"));
        try { localStorage.setItem("view", v); } catch (e) {}
        if (push) { const u = new URL(location.href); u.searchParams.set("view", v); history.replaceState(null, "", u); }
      };
      let saved = null;
      try { saved = localStorage.getItem("view"); } catch (e) {}
      set(new URLSearchParams(location.search).get("view") || saved || "read", false);
      document.querySelectorAll("[data-view-btn]").forEach((a) => a.addEventListener("click", (e) => { e.preventDefault(); set(a.dataset.viewBtn, true); }));

      // A term opens its glossary entry as a note beside the text; without the popover API the link goes to the glossary.
      const pop = document.getElementById("pop");
      if (!pop.showPopover) return;
      document.addEventListener("click", (e) => {
        const a = e.target.closest("a.term");
        if (a) {
          const entry = document.getElementById("gl-" + a.dataset.term);
          if (!entry) return;
          e.preventDefault();
          pop.innerHTML = '<button type="button" class="pop-x" aria-label="Close">✕</button>' + entry.innerHTML;
          pop.showPopover();
          pop.querySelector(".pop-x").focus();
          return;
        }
        if (e.target.closest(".pop-x") || e.target.closest("#pop [data-close], #pop a[href^='#']")) pop.hidePopover();
      });
    })();
  </script>
</Base>
