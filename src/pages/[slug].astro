---
import Base from "../layouts/Base.astro";
import Parts from "../components/Parts.astro";
import GlossBody from "../components/GlossBody.astro";
import Words from "../components/Words.astro";
import ReviewChip from "../components/ReviewChip.astro";
import { texts, site, url, type Text } from "../lib/data";

export function getStaticPaths() {
  return texts.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}
const { t } = Astro.props as { t: Text };
const lec = t.lectures[0];
const teacher = t.teacher_en.split(" (")[0];
const notesSeries = lec && `${site.notes}/${lec.channel}/${lec.playlist}/`;
const pageUrl = new URL(url(`${t.slug}/`), Astro.site).href;
const jsonld = {
  "@context": "https://schema.org", "@type": "CreativeWork", name: t.title_en, alternateName: [t.title_zh, t.title_pinyin],
  inLanguage: "en", url: pageUrl, isAccessibleForFree: true, license: "https://creativecommons.org/licenses/by-nc-sa/4.0/",
  translationOfWork: { "@type": "CreativeWork", name: t.title_zh, inLanguage: "zh-Hant", author: { "@type": "Person", name: t.author_en }, identifier: `CBETA ${t.id}` },
  translator: { "@type": "Organization", name: "Claude (Anthropic), AI-generated under human direction" },
  creativeWorkStatus: "Provisional",
};
const description = `${t.title_en} (${t.title_zh}, ${t.author_en}, CBETA ${t.id}): an AI translation following ${t.teacher_en}'s lectures, to read on its own or line by line beside the Chinese with the teacher's own words.`;
const VIEWS = [["read", "Read", "Read"], ["bilingual", "Side by side", "Bilingual"], ["how", "How it was made", "How"]];
---
<Base title={`${t.title_en} — English translation`} description={description} jsonld={jsonld} type="article" wide>
  <div class="reader">
  {/* 目次 rail (wide screens); on a narrow screen the same list folds out of the toolbar */}
  <div class="side">
    <nav class="toc" aria-label="Contents">
      <p class="toc-h">CONTENTS · 目次</p>
      <ol>
        {t.guide.length > 0 && <li><a href="#guide">Before you read</a></li>}
        {t.sections.map((s) => <li><a href={`#${s.start}`}>{s.en}</a></li>)}
        {t.glossary.length > 0 && <li class="toc-sep"><a href="#glossary">Glossary</a></li>}
      </ol>
    </nav>
  </div>
  <div class="reader-main" id="text" data-view="read">
  <header class="text-head">
    <p class="zh" lang="zh-Hant">{t.title_zh}</p>
    <h1>{t.title_en}</h1>
    <p class="meta"><i>{t.title_pinyin}</i> · {t.author_en} · CBETA {t.id} · {t.n_segs} lines</p>
    <p class="meta">Read with the lectures of {t.teacher_en}{notesSeries && <>: <a href={notesSeries} lang="zh-Hant">study notes and transcripts</a> · <a href={`${site.notes}/sutra/${t.id}/`} lang="zh-Hant">every lecture citing this text</a></>}</p>
  </header>

  <div class="notice">
    <p><strong>An AI translation, following {teacher}'s lectures.</strong> The English was made by AI (Anthropic's Claude), choosing between the readings the Chinese allows as {teacher} reads them in his lectures on this text. {t.reviewers.length > 1
      ? <>Two AI reviewers from different model families, {t.reviewers.join(" and ")}, then checked every line against the Chinese and his own words.</>
      : <>A second AI review{t.reviewers.length ? <> by {t.reviewers[0]}</> : null} then checked every line against the Chinese and his own words.</>}{t.n_owner > 0 && <> {t.n_owner} of {t.n_segs} lines have also been reviewed by the project owner.</>} It is not an official translation.</p>
    <p><a href={url("method/")}>How it is made</a> · <a href={url(`files/${t.id}.tsv`)} download>Download (TSV)</a></p>
  </div>

  {t.guide.length > 0 && (
    <section class="guide">
      <h2 id="guide">Before you read</h2>
      {t.guide.map((g) => (
        <div class="guide-item" id={`gl-${g.id}`}>
          <h3>{g.term}</h3>
          <GlossBody g={g} teacher={teacher} />
        </div>
      ))}
    </section>
  )}

  <nav class="toolbar" aria-label="Text views">
    <div class="seg-switch" role="group" aria-label="View">
      {VIEWS.map(([v, l, short]) => <a href={`?view=${v}`} data-view-btn={v}><span class="lbl-long">{l}</span><span class="lbl-short">{short}</span></a>)}
    </div>
    <details class="toc-menu narrow-only">
      <summary>目次</summary>
      <nav class="toc" aria-label="Contents">
        <ol>
          {t.guide.length > 0 && <li><a href="#guide">Before you read</a></li>}
          {t.sections.map((s) => <li><a href={`#${s.start}`}>{s.en} <span lang="zh-Hant" class="muted">{s.zh}</span></a></li>)}
          {t.glossary.length > 0 && <li class="toc-sep"><a href="#glossary">Glossary</a></li>}
        </ol>
      </nav>
    </details>
  </nav>
  <p class="view-note only-read">The English on its own. Underlined terms open a note: what the term is, where Fazang explains it, and how {teacher} explains it.</p>
  <p class="view-note only-bilingual">The Chinese beside the English, line by line.</p>
  <p class="view-note only-how">Line by line with its evidence. Open <em>Why this reading</em> under a line for the reading of {teacher} it follows, his own words from the lecture (法師原話), and the study notes on the passage (筆記整理). ⚠ marks a doubt, a variant or a traced quotation; [Tr.] is a note on a word, never on doctrine.</p>

  {t.sections.map((s) => (
    <section class="sec">
      <h2 class="section-head" id={s.start}>{s.en}<span class="zh" lang="zh-Hant">{s.zh}</span></h2>
      <div class="segs">
      {s.segs.map((g) => (
        <div class="seg" id={g.id}>
          <div class="seg-id"><a href={`#${g.id}`}>{g.id}</a></div>
          <p class="zh" lang="zh-Hant">{g.zh}</p>
          <p class="en"><Parts parts={g.en_parts} /></p>
          <details class="why">
            <summary>Why this reading <ReviewChip r={g.review} by={g.reviewers} /></summary>
            <dl>
              {g.basis && <><dt>Teacher's reading</dt><dd><Parts parts={g.basis_parts} /></dd></>}
              {g.words.length > 0 && <><dt lang="zh-Hant">法師原話</dt><dd>
                <p class="ev-lbl">His own words where he gives this reading (lecture transcript)</p>
                {g.words.map((w) => <Words w={w} />)}</dd></>}
              {g.notes.length > 0 && <><dt lang="zh-Hant">筆記整理</dt><dd>
                <p class="ev-lbl">The study notes on this passage</p>
                {g.notes.map((n) => (
                  <div class="note-row" lang="zh-Hant">
                    <p class="note-q">{n.quote}</p>
                    <p class="note-x">{n.explanation}</p>
                    {n.words.length > 0 && n.href && (
                      <details class="note-w"><summary>法師原話</summary>
                        <Words w={{ lesson: n.lesson, a: n.a, b: n.b, lines: n.words, href: n.href }} />
                      </details>
                    )}
                  </div>
                ))}</dd></>}
              {g.flags && <><dt>Notes</dt><dd class={g.flags.includes("⚠") ? "flag" : undefined}><Parts parts={g.flags_parts} /></dd></>}
              {g.resolution && <><dt>Review</dt><dd>A reviewer objected; the objection was checked against the sources and answered: {g.resolution}</dd></>}
              {!g.basis && !g.words.length && !g.notes.length && <><dt>Teacher's reading</dt><dd class="muted">None needed: the Chinese allows one reading here.</dd></>}
            </dl>
          </details>
        </div>
      ))}
      </div>
    </section>
  ))}

  {t.glossary.length > 0 && (
    <section class="glossary">
      <h2 id="glossary">Glossary</h2>
      <dl>
        {t.glossary.map((g) => (
          <div class="gl-entry" id={`gl-${g.id}`}>
            <dt><span class="gl-term">{g.term}</span> <span lang="zh-Hant">{g.zh}</span>{g.first_seg && <a class="gl-first" href={`#${g.first_seg}`}>{g.first_seg}</a>}</dt>
            <dd><GlossBody g={g} teacher={teacher} /></dd>
          </div>
        ))}
      </dl>
    </section>
  )}
  </div>
  </div>

  <div id="pop" popover class="pop" role="dialog" aria-label="Term note"></div>

  <script is:inline>
    (() => {
      const box = document.getElementById("text"), VIEWS = ["read", "bilingual", "how"];
      // the line nearest the top of the screen, so switching view keeps the reader's place
      const anchor = () => [...document.querySelectorAll(".seg")].find((el) => el.getBoundingClientRect().bottom > 80);
      const set = (v, push) => {
        if (!VIEWS.includes(v)) v = "read";
        const keep = push && anchor(), off = keep && keep.getBoundingClientRect().top;
        box.dataset.view = v;
        document.querySelectorAll("[data-view-btn]").forEach((a) => a.setAttribute("aria-current", a.dataset.viewBtn === v ? "true" : "false"));
        try { localStorage.setItem("view", v); } catch (e) {}
        if (push) {
          const u = new URL(location.href); u.searchParams.set("view", v); history.replaceState(null, "", u);
          if (keep && off > 0) scrollBy(0, keep.getBoundingClientRect().top - off);
        }
      };
      let saved = null;
      try { saved = localStorage.getItem("view"); } catch (e) {}
      set(new URLSearchParams(location.search).get("view") || saved || "read", false);
      document.querySelectorAll("[data-view-btn]").forEach((a) => a.addEventListener("click", (e) => { e.preventDefault(); set(a.dataset.viewBtn, true); }));
      document.querySelectorAll(".toc-menu a").forEach((a) => a.addEventListener("click", () => a.closest("details").removeAttribute("open")));

      // A term opens its glossary entry as a note; without the popover API the link goes to the glossary.
      const pop = document.getElementById("pop");
      if (!pop.showPopover) return;
      document.addEventListener("click", (e) => {
        const a = e.target.closest("a.term");
        if (a) {
          const entry = document.getElementById("gl-" + a.dataset.term);
          if (!entry) return;
          e.preventDefault();
          pop.innerHTML = '<button type="button" class="pop-x" aria-label="Close">✕</button>' + entry.innerHTML;
          pop.showPopover();
          pop.querySelector(".pop-x").focus();
          return;
        }
        if (e.target.closest(".pop-x") || e.target.closest("#pop [data-close], #pop a[href^='#']")) pop.hidePopover();
      });
    })();
  </script>
</Base>
